# =============================================================================
# FluxRules - Environment Configuration Reference
# =============================================================================
# This file documents all available environment variables for FluxRules.
# For API server setup, copy this to your root directory as `.env` and adjust values.
#
#   cp docs/.env.example .env
#
# All variables below map to `fluxrules.api.config.Settings` fields.
# =============================================================================

# ---------------------------------------------------------------------------
# Project metadata
# ---------------------------------------------------------------------------
PROJECT_NAME=FluxRules
VERSION=1.0.0
API_V1_STR=/api/v1

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLite (default, good for local dev):
DATABASE_URL=sqlite:///./rule_engine.db
# PostgreSQL example:
# DATABASE_URL=postgresql://user:password@localhost:5432/fluxrules

# When True (default), the app falls back to SQLite if the primary DB is unreachable.
# Set to False in production to fail fast.
DB_FALLBACK_ENABLED=true

# ---------------------------------------------------------------------------
# Redis (optional - analytics falls back to in-memory if unavailable)
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ---------------------------------------------------------------------------
# JWT / Authentication
# ---------------------------------------------------------------------------
# ⚠️  CHANGE THIS in production!  Must be ≥32 characters.
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---------------------------------------------------------------------------
# Admin seed control
# ---------------------------------------------------------------------------
# Whether to create a default admin user on first startup.
SEED_ADMIN_USER=true
# Override the default admin password (leave empty to auto-generate).
ADMIN_DEFAULT_PASSWORD=
# Force password change on first login.
ADMIN_FORCE_PASSWORD_CHANGE=true

# ---------------------------------------------------------------------------
# Engine settings
# ---------------------------------------------------------------------------
# Use the optimized PHREAK engine (set to false for simple evaluator fallback).
USE_OPTIMIZED_ENGINE=true
# Rule cache TTL in seconds.
RULE_CACHE_TTL=300
# Local (per-process) cache TTL in seconds.
RULE_LOCAL_CACHE_TTL=60
# Validation mode (only "brms" is supported).
RULE_VALIDATION_MODE=brms

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------
WORKER_CONCURRENCY=4

# ---------------------------------------------------------------------------
# CORS (restrict in production!)
# ---------------------------------------------------------------------------
# Comma-separated allowed origins. Use "*" ONLY for local dev.
# Example: https://app.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=*
# Comma-separated HTTP methods.
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
# Comma-separated headers.
CORS_ALLOWED_HEADERS=Authorization,Content-Type,Accept
# Allow credentials in cross-origin requests.
CORS_ALLOW_CREDENTIALS=true

# ---------------------------------------------------------------------------
# Audit / Retention
# ---------------------------------------------------------------------------
# Days to retain audit-log entries (0 = keep forever).
AUDIT_RETENTION_DAYS=0
# HMAC-SHA256 integrity hashing for audit rows.
AUDIT_INTEGRITY_ENABLED=true

# ---------------------------------------------------------------------------
# Scheduled audit policies
# ---------------------------------------------------------------------------
# Enable cron-based automatic audit sweeps (opt-in for staging/production).
AUDIT_SCHEDULER_ENABLED=false

# ---------------------------------------------------------------------------
# Schema versioning
# ---------------------------------------------------------------------------
# Expected Alembic schema version. Do not change unless you know what you're doing.
SCHEMA_VERSION=002

# ---------------------------------------------------------------------------
# Environment flag
# ---------------------------------------------------------------------------
# Controls strictness of security checks. Values: development, production
FLUXRULES_ENV=development
